{
  "name": "used-book-marketplace",
  "version": "0.1.0",
  "private": true,
  "description": "Shared platform for the Flutter, React Native, and graduation projects.",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "dev:api": "pnpm --filter @used-books/api start:dev",
    "dev:admin": "pnpm --filter @used-books/admin-web dev",
    "dev:rn": "pnpm --filter @used-books/mobile-react-native start",
    "build": "pnpm -r --if-present run build",
    "lint": "pnpm -r --if-present run lint",
    "typecheck": "pnpm -r --if-present run typecheck",
    "test": "pnpm -r --if-present run test",
    "infra:up": "docker compose -f infra/docker-compose.yml up -d",
    "infra:down": "docker compose -f infra/docker-compose.yml down",
    "infra:logs": "docker compose -f infra/docker-compose.yml logs -f"
  }
}
