NODE_ENV=development
PORT=3000
CORS_ORIGINS=http://localhost:5173,http://localhost:8081
DATABASE_URL=postgresql://usedbooks:usedbooks_dev@localhost:5432/usedbooks?schema=public
REDIS_URL=redis://localhost:6379
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
# Only used by the local development seed. Never use these accounts in production.
DEV_SEED_PASSWORD=LatLai-Local-2026!

# Optional until real media storage is connected. Both values must be set together.
# Backend only: NEVER use EXPO_PUBLIC_ for storage credentials.
SUPABASE_URL=
SUPABASE_STORAGE_KEY=
SUPABASE_MEDIA_BUCKET=latlai-media
# Dedicated Free-plan bucket. Reservations include input + three bounded outputs.
MEDIA_STORAGE_BUDGET_BYTES=800000000
# Optional, dev/test only: >=32 random characters; unset disables simulated funding.
# Never place this in a client env file. Production refuses to boot with it set.
# Shared by local topup and carrier-pickup adapters with separate HMAC domains.
# Leave empty to disable both; forbidden in production. Never expose to clients.
PAYMENT_SIMULATOR_SECRET=
