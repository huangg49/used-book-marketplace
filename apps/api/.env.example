NODE_ENV=development
PORT=3000
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:8081,http://127.0.0.1:5186,http://localhost:5186
# MongoDB 8 replica set (ADR 0027; infra/docker-compose.yml service `mongo`).
# API and workers connect as the least-privilege app user; migrations run as the
# migrator. pnpm setup:local generates the passwords; pnpm db:bootstrap creates
# both users through MONGODB_ADMIN_URL (root password from the root .env).
MONGODB_URL=mongodb://latlai_app:replace-app-password@localhost:27017/latlai?directConnection=true&authSource=latlai
MONGODB_MIGRATOR_URL=mongodb://latlai_migrator:replace-migrator-password@localhost:27017/latlai?directConnection=true&authSource=latlai
MONGODB_ADMIN_URL=mongodb://latlai_root:replace-root-password@localhost:27017/admin?directConnection=true&authSource=admin
MONGODB_DATABASE=latlai
MONGODB_APP_PASSWORD=replace-app-password
MONGODB_MIGRATOR_PASSWORD=replace-migrator-password
# One-time PostgreSQL import only (docs/refactor/MIG06_CUTOVER_RUNBOOK.md):
# SOURCE_DATABASE_URL=postgresql://usedbooks:usedbooks_dev@localhost:5432/usedbooks
REDIS_URL=redis://localhost:6379
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
# Only used by the local development seed. Never use these accounts in production.
DEV_SEED_PASSWORD=LatLai-Local-2026!

# Optional until real media storage is connected. Both values must be set together.
# Backend only: NEVER use EXPO_PUBLIC_ for storage credentials.
SUPABASE_URL=
SUPABASE_STORAGE_KEY=
SUPABASE_MEDIA_BUCKET=latlai-media
# Dedicated Free-plan bucket. Reservations include input + three bounded outputs.
MEDIA_STORAGE_BUDGET_BYTES=800000000
# Optional, dev/test only: >=32 random characters; unset disables simulated funding.
# Never place this in a client env file. Production refuses to boot with it set.
# Shared by local topup and carrier-pickup adapters with separate HMAC domains.
# Leave empty to disable both; forbidden in production. Never expose to clients.
PAYMENT_SIMULATOR_SECRET=

# Price assistant (ADR 0028). Off by default; keep the key only in your local
# .env (never commit/share it). Daily budget and per-user limit cap spend.
PRICE_ASSIST_ENABLED=false
PRICE_ASSIST_API_KEY=
# anthropic (default model claude-opus-5-5) or gemini (default gemini-3.8-flash)
PRICE_ASSIST_PROVIDER=anthropic
PRICE_ASSIST_MODEL=
PRICE_ASSIST_EFFORT=low
PRICE_ASSIST_TIMEOUT_MS=20000
PRICE_ASSIST_USER_DAILY_LIMIT=20
PRICE_ASSIST_DAILY_BUDGET_USD=2
# Online new-book price lookup (ADR 0029): Gemini + Google Search, needs the
# assistant enabled with PRICE_ASSIST_PROVIDER=gemini. Shops are a proposal for
# the owner to confirm; prices are read only from these domains' pages.
PRICE_LOOKUP_ENABLED=false
PRICE_LOOKUP_SHOPS=fahasa.com,tiki.vn,nhanam.vn,nxbtre.com.vn,nxbkimdong.com.vn
PRICE_LOOKUP_TTL_DAYS=30
PRICE_LOOKUP_DAILY_LIMIT=50
# USD per grounded search request, added to token cost (check Google's price list).
PRICE_LOOKUP_SEARCH_USD=0.035
# Account email (local delivery is development/test only; never production).
# Run pnpm auth:mailbox to read demo messages at http://127.0.0.1:3186/.
AUTH_MAIL_PROVIDER=local
AUTH_WEB_ORIGIN=http://127.0.0.1:5186
# Optional in development: falls back to a domain-separated JWT secret key.
# Production/resend: set a separate >=32-character random encryption key.
AUTH_MAIL_ENCRYPTION_KEY=
AUTH_MAIL_LOCAL_DIR=.tmp/auth-mail
# For real delivery, change provider to resend and configure a verified sender.
RESEND_API_KEY=
AUTH_MAIL_FROM=Lật Lại <onboarding@resend.dev>
