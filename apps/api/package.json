{
  "name": "@used-books/api",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "nest build",
    "deploy": "nest deploy",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "worker:media": "node dist/media-worker.js",
    "media:check": "tsx src/media-check.ts",
    "media:probe": "tsx src/media-check.ts --probe",
    "doctor:local": "tsx src/local-check.ts",
    "worker:media:prod": "node dist/media-worker.js",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "oxlint src/ test/",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "test:mongo": "vitest run --config ./vitest.config.mongo.ts",
    "worker:orders": "nest start --entryFile order-worker",
    "worker:orders:prod": "node dist/order-worker.js",
    "wallet:check": "node dist/wallet-check.js",
    "mongo:bootstrap": "tsx src/mongo-bootstrap.ts",
    "mongo:migrate": "tsx src/mongo-migrate.ts",
    "mongo:seed": "tsx src/mongo-seed.ts",
    "mongo:seed-exchange": "tsx src/seed-exchange-data.ts",
    "mongo:seed-preferences": "tsx src/seed-exchange-preferences.ts",
    "price-refs:import": "tsx src/price-refs-import.ts",
    "eval:price": "tsx eval/price-assist/run.ts",
    "eval:autofill": "tsx eval/autofill-assist/run.ts",
    "eval:compare": "tsx eval/autofill-assist/compare.ts",
    "eval:endpoints": "tsx eval/autofill-assist/probe-endpoints.ts",
    "mongo:check": "node dist/mongo-check.js",
    "mongo:import-postgres": "tsx src/mongo-import-postgres.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "^12.0.1",
    "@nestjs/jwt": "^12.0.2",
    "@nestjs/passport": "^12.0.0",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/platform-socket.io": "^12.0.3",
    "@nestjs/swagger": "^12.0.1",
    "@nestjs/websockets": "^12.0.3",
    "@supabase/storage-js": "^2.117.2",
    "@used-books/api-contract": "workspace:*",
    "@zxing/library": "0.23.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "argon2": "^0.45.1",
    "bullmq": "^6.3.8",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^17.3.1",
    "ioredis": "^6.0.0",
    "mongodb": "7.6.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "8.23.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sharp": "^0.35.4",
    "tldts": "7.4.19",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/mau": "^0.2.6",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/passport-jwt": "^4.0.1",
    "@types/pg": "8.23.1",
    "@types/supertest": "^7.0.0",
    "@vitest/coverage-v8": "^4.1.2",
    "oxlint": "^1.58.0",
    "prettier": "^3.4.2",
    "socket.io-client": "4.8.3",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.2",
    "vitest": "^4.1.2"
  }
}
