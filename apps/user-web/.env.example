# Biến môi trường dành cho user-web (Vite)
# Sao chép file này thành .env và điền giá trị phù hợp với môi trường local.
# KHÔNG commit file .env vào git.

# URL gốc của API backend (NestJS)
VITE_API_BASE_URL=http://localhost:3000/api/v1

# Optional: exact hostname of your own dev tunnel, without https:// or paths.
# Set locally in .env.local; leave empty when using localhost.
LATLAI_DEV_ALLOWED_HOST=

# Local backend origin for /api and Socket.IO proxy. With a tunnel, set
# VITE_API_BASE_URL=/api/v1 so localhost also works when the tunnel is off.
LATLAI_DEV_API_ORIGIN=http://localhost:3000

# Chỉ dev: hiện catalog Open Library cho UX/UI, giá/tình trạng là mẫu.
# false dùng bài đăng thật; cũng có thể mở /?data=preview hoặc /?data=live trong dev.
VITE_CATALOG_PREVIEW=false
