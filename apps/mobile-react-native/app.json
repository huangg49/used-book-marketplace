{
  "expo": {
    "name": "Lật lại",
    "slug": "mobile-react-native",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/brand/icon.png",
    "scheme": "mobilereactnative",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/brand/icon.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F5EFDF",
        "foregroundImage": "./assets/brand/adaptive-foreground.png",
        "monochromeImage": "./assets/brand/adaptive-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.huangg49.mobilereactnative"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/brand/favicon.png"
    },
    "plugins": [
      "expo-router",
      "./plugins/with-font-scale.cjs",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F5EFDF",
          "image": "./assets/brand/splash.png",
          "imageWidth": 120
        }
      ],
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Cho phép Lật lại chọn ảnh sách bạn muốn đăng.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
