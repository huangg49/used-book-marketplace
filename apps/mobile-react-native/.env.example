EXPO_PUBLIC_API_BASE_URL=http://localhost:3000/api/v1
# dev:rn derives 10.0.2.2 for Android emulator and retains localhost for web/iOS.
# Override only when needed (e.g. a physical phone on trusted Wi-Fi):
# EXPO_PUBLIC_API_BASE_URL_ANDROID=http://192.168.1.10:3000/api/v1
# EXPO_PUBLIC_API_BASE_URL_WEB=http://localhost:3000/api/v1
# Opt in locally to /design, an isolated interactive design study with sample data.
# EXPO_PUBLIC_DESIGN_PREVIEW=1
# Internal read-only Member views; default hidden, not an authorization mechanism.
# EXPO_PUBLIC_INTERNAL_MEMBER_VIEWS=1
