NODE_ENV=development
PORT=3000
# Compose host port. If occupied, update DATABASE_URL here and in apps/api/.env to match.
POSTGRES_PORT=5432
DATABASE_URL=postgresql://usedbooks:usedbooks_dev@localhost:5432/usedbooks?schema=public
REDIS_URL=redis://localhost:6379
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
# Media credentials belong in apps/api/.env only. See docs/features/SUPABASE_MEDIA_SETUP.md.
MAIL_HOST=localhost
MAIL_PORT=1025
