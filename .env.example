NODE_ENV=development
PORT=3000
# MongoDB (infra/docker-compose.yml service `mongo`, single-node replica set with
# auth). pnpm setup:local generates the root password; the API never uses root.
# If the host port is occupied, change MONGO_PORT here and the port in apps/api/.env.
MONGO_PORT=27017
MONGO_ROOT_PASSWORD=replace-root-password
# Legacy PostgreSQL (profile legacy-postgres) is only the one-time import source.
POSTGRES_PORT=5432
REDIS_URL=redis://localhost:6379
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
# Media credentials belong in apps/api/.env only. See docs/features/SUPABASE_MEDIA_SETUP.md.
MAIL_HOST=localhost
MAIL_PORT=1025
