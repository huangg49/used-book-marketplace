@startuml
left to right direction
skinparam defaultFontName Arial
skinparam defaultFontSize 15
skinparam dpi 160
skinparam shadowing false
skinparam backgroundColor white
skinparam ArrowColor #425365
skinparam ArrowThickness 1
skinparam ActorBorderColor #273748
skinparam ActorFontColor #162536
skinparam UsecaseBackgroundColor #F4F8FC
skinparam UsecaseBorderColor #54728C
skinparam UsecaseFontColor #152B3D
skinparam RectangleBorderColor #758594
skinparam RectangleBackgroundColor white
skinparam RectangleFontColor #152B3D
skinparam NoteBackgroundColor #FFFDF5
skinparam NoteBorderColor #C5B984
skinparam NoteFontSize 12
skinparam TitleFontSize 21
skinparam TitleFontColor black
skinparam FooterFontSize 11
skinparam FooterFontColor #5F6B76
skinparam nodesep 35
skinparam ranksep 70
hide stereotype

title Book purchase and delivery tracking
footer SRS-BOOK-001 v1.0 | 03_Mua_ban_sach | Goal-oriented diagram; processing order is not shown
actor "Buyer" as buyer
actor "Seller" as seller
actor "Carrier Simulator (simulated service)" as carrier
rectangle "Used-book marketplace" as PLATFORM {
  usecase "OR01\nManage cart" as OR01
  usecase "OR02\nCreate an order\nfor one listing" as OR02
  usecase "OR03\nValidate conditions\nand reserve the book" as OR03
  usecase "OR04\nPay for order\nwith wallet" as OR04
  usecase "OR05\nHold payment funds" as OR05
  usecase "OR06\nConfirm or\nreject order" as OR06
  usecase "OR07\nCancel or request\norder cancellation" as OR07
  usecase "OR08\nSubmit tracking\nand packing photos" as OR08
  usecase "OR09\nUpdate shipment\nstatus" as OR09
  usecase "OR10\nConfirm receipt of book" as OR10
  usecase "OR11\nView order progress\nand settlement" as OR11
}
buyer -- OR01
buyer -- OR02
buyer -- OR04
buyer -- OR07
buyer -- OR10
buyer -- OR11
seller -- OR06
seller -- OR07
seller -- OR08
seller -- OR11
carrier -- OR09
OR02 ..> OR03 : <<include>>
OR04 ..> OR05 : <<include>>
@enduml
