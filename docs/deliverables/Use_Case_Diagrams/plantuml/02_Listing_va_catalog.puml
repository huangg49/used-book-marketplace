@startuml
left to right direction
skinparam defaultFontName Arial
skinparam defaultFontSize 15
skinparam dpi 160
skinparam shadowing false
skinparam backgroundColor white
skinparam ArrowColor #425365
skinparam ArrowThickness 1
skinparam ActorBorderColor #273748
skinparam ActorFontColor #162536
skinparam UsecaseBackgroundColor #F4F8FC
skinparam UsecaseBorderColor #54728C
skinparam UsecaseFontColor #152B3D
skinparam RectangleBorderColor #758594
skinparam RectangleBackgroundColor white
skinparam RectangleFontColor #152B3D
skinparam NoteBackgroundColor #FFFDF5
skinparam NoteBorderColor #C5B984
skinparam NoteFontSize 12
skinparam TitleFontSize 21
skinparam TitleFontColor black
skinparam FooterFontSize 11
skinparam FooterFontColor #5F6B76
skinparam nodesep 35
skinparam ranksep 70
hide stereotype

title Listing moderation and catalog management
footer SRS-BOOK-001 v1.0 | 02_Listing_va_catalog | Goal-oriented diagram; processing order is not shown
actor "Book seller" as seller
actor "Staff" as staff
actor "Admin" as admin
rectangle "Used-book marketplace" as PLATFORM {
  usecase "LI01\nCreate and edit\na listing draft" as LI01
  usecase "LI02\nRequest a new\ncatalog book" as LI02
  usecase "LI03\nSubmit listing for review" as LI03
  usecase "LI04\nValidate listing data\nand publishing rules" as LI04
  usecase "LI05\nApprove or reject\na listing" as LI05
  usecase "LI06\nEdit an approved listing" as LI06
  usecase "LI07\nHide, republish or soft-delete\nmy listing" as LI07
  usecase "LI08\nRemove a violating listing" as LI08
  usecase "LI09\nManage catalog\nand duplicate records" as LI09
  usecase "LI10\nPreserve related\ntransaction records" as LI10
}
seller -- LI01
seller -- LI02
seller -- LI03
seller -- LI06
seller -- LI07
staff -- LI05
staff -- LI08
admin -- LI05
admin -- LI08
admin -- LI09
LI03 ..> LI04 : <<include>>
LI10 .up.> LI08 : <<extend>>
legend bottom left
LI10 extends LI08: The listing has an active transaction
Extension point of LI08: Handle removal impact
endlegend
@enduml
