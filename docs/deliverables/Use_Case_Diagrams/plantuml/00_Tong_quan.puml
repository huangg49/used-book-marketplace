@startuml
left to right direction
skinparam defaultFontName Arial
skinparam defaultFontSize 15
skinparam dpi 160
skinparam shadowing false
skinparam backgroundColor white
skinparam ArrowColor #425365
skinparam ArrowThickness 1
skinparam ActorBorderColor #273748
skinparam ActorFontColor #162536
skinparam UsecaseBackgroundColor #F4F8FC
skinparam UsecaseBorderColor #54728C
skinparam UsecaseFontColor #152B3D
skinparam RectangleBorderColor #758594
skinparam RectangleBackgroundColor white
skinparam RectangleFontColor #152B3D
skinparam NoteBackgroundColor #FFFDF5
skinparam NoteBorderColor #C5B984
skinparam NoteFontSize 12
skinparam TitleFontSize 21
skinparam TitleFontColor black
skinparam FooterFontSize 11
skinparam FooterFontColor #5F6B76
skinparam nodesep 35
skinparam ranksep 70
hide stereotype

title Overview of the used-book marketplace
footer SRS-BOOK-001 v1.0 | 00_Tong_quan | Goal-oriented diagram; processing order is not shown
actor "Guest" as guest
actor "Member" as member
actor "Staff" as staff
actor "Admin" as admin
actor "Payment Simulator (simulated service)" as pay
actor "Carrier Simulator (simulated service)" as carrier
rectangle "Used-book marketplace" as PLATFORM {
  usecase "OV01\nBrowse books and\npublic content" as OV01
  usecase "OV02\nRegister and manage\nan account" as OV02
  usecase "OV03\nCreate and manage\nyour listings" as OV03
  usecase "OV04\nBuy and sell books" as OV04
  usecase "OV05\nExchange books" as OV05
  usecase "OV06\nManage wallet and\nsimulated top-ups and withdrawals" as OV06
  usecase "OV07\nRaise and resolve\ndisputes" as OV07
  usecase "OV08\nDiscuss and\nreview transactions" as OV08
  usecase "OV09\nModerate content and\nhandle violations" as OV09
  usecase "OV10\nAdminister and\nreconcile the system" as OV10
  usecase "OV11\nUpdate shipments\nand returns" as OV11
}
guest -- OV01
guest -- OV02
member -- OV01
member -- OV02
member -- OV03
member -- OV04
member -- OV05
member -- OV06
member -- OV07
member -- OV08
staff -- OV07
staff -- OV09
admin -- OV06
admin -- OV07
admin -- OV09
admin -- OV10
pay -- OV06
carrier -- OV11
@enduml
