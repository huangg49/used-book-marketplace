@startuml
left to right direction
skinparam defaultFontName Arial
skinparam defaultFontSize 15
skinparam dpi 160
skinparam shadowing false
skinparam backgroundColor white
skinparam ArrowColor #425365
skinparam ArrowThickness 1
skinparam ActorBorderColor #273748
skinparam ActorFontColor #162536
skinparam UsecaseBackgroundColor #F4F8FC
skinparam UsecaseBorderColor #54728C
skinparam UsecaseFontColor #152B3D
skinparam RectangleBorderColor #758594
skinparam RectangleBackgroundColor white
skinparam RectangleFontColor #152B3D
skinparam NoteBackgroundColor #FFFDF5
skinparam NoteBorderColor #C5B984
skinparam NoteFontSize 12
skinparam TitleFontSize 21
skinparam TitleFontColor black
skinparam FooterFontSize 11
skinparam FooterFontColor #5F6B76
skinparam nodesep 35
skinparam ranksep 70
hide stereotype

title Forum chat wishlist notifications and reviews
footer SRS-BOOK-001 v1.0 | 07_Cong_dong_va_danh_gia | Goal-oriented diagram; processing order is not shown
actor "Visitor" as visitor
actor "Member" as member
actor "Moderator" as moderator
rectangle "Used-book marketplace" as PLATFORM {
  usecase "CO01\nRead topics and\npublic reviews" as CO01
  usecase "CO02\nCreate or edit\ntopic and comments" as CO02
  usecase "CO03\nAttach my listing\nto topic" as CO03
  usecase "CO04\nAttach wanted\ncatalog book" as CO04
  usecase "CO05\nMessage and\nreport or block chat" as CO05
  usecase "CO06\nManage wishlist\nand notification settings" as CO06
  usecase "CO07\nView and mark\nnotifications read" as CO07
  usecase "CO08\nSubmit review\nfor completed transaction" as CO08
  usecase "CO09\nValidate review\neligibility and deadline" as CO09
  usecase "CO10\nEdit or delete review\nor post a reply" as CO10
  usecase "CO11\nReport violating\ncontent" as CO11
  usecase "CO12\nModerate content\nand reviews" as CO12
}
visitor -- CO01
member -- CO02
member -- CO05
member -- CO06
member -- CO07
member -- CO08
member -- CO10
member -- CO11
moderator -- CO12
CO03 .up.> CO02 : <<extend>>
CO04 .up.> CO02 : <<extend>>
CO08 ..> CO09 : <<include>>
legend bottom left
CO03 extends CO02: The author chooses to attach their own listing
Extension point of CO02: Attach topic content
CO04 extends CO02: The author chooses a wanted catalog book
Extension point of CO02: Attach topic content
endlegend
@enduml
