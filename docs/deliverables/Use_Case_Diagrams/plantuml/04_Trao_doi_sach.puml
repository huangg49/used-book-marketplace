@startuml
left to right direction
skinparam defaultFontName Arial
skinparam defaultFontSize 15
skinparam dpi 160
skinparam shadowing false
skinparam backgroundColor white
skinparam ArrowColor #425365
skinparam ArrowThickness 1
skinparam ActorBorderColor #273748
skinparam ActorFontColor #162536
skinparam UsecaseBackgroundColor #F4F8FC
skinparam UsecaseBorderColor #54728C
skinparam UsecaseFontColor #152B3D
skinparam RectangleBorderColor #758594
skinparam RectangleBackgroundColor white
skinparam RectangleFontColor #152B3D
skinparam NoteBackgroundColor #FFFDF5
skinparam NoteBorderColor #C5B984
skinparam NoteFontSize 12
skinparam TitleFontSize 21
skinparam TitleFontColor black
skinparam FooterFontSize 11
skinparam FooterFontColor #5F6B76
skinparam nodesep 35
skinparam ranksep 70
hide stereotype

title Book exchange with deposits and cash difference
footer SRS-BOOK-001 v1.0 | 04_Trao_doi_sach | Goal-oriented diagram; processing order is not shown
actor "Exchange party" as party
actor "Carrier Simulator (simulated service)" as carrier
rectangle "Used-book marketplace" as PLATFORM {
  usecase "EX01\nCreate exchange proposal" as EX01
  usecase "EX02\nCalculate and display\nboth parties’ payment obligations" as EX02
  usecase "EX03\nSend counter-offer" as EX03
  usecase "EX04\nAccept current\nproposal" as EX04
  usecase "EX05\nValidate revision and\nreserve both books atomically" as EX05
  usecase "EX06\nReject, withdraw or\nrequest exchange cancellation" as EX06
  usecase "EX07\nFulfill my\npayment duty" as EX07
  usecase "EX08\nPay exchange deposit" as EX08
  usecase "EX09\nPay cash difference" as EX09
  usecase "EX10\nSubmit shipment\nfor my book" as EX10
  usecase "EX11\nUpdate each\nshipment leg" as EX11
  usecase "EX12\nConfirm receipt\nof the other book" as EX12
  usecase "EX13\nTrack exchange\nand settlement result" as EX13
}
party -- EX01
party -- EX03
party -- EX04
party -- EX06
party -- EX07
party -- EX10
party -- EX12
party -- EX13
carrier -- EX11
EX01 ..> EX02 : <<include>>
EX03 ..> EX02 : <<include>>
EX04 ..> EX05 : <<include>>
EX07 ..> EX08 : <<include>>
EX09 .up.> EX07 : <<extend>>
legend bottom left
EX09 extends EX07: Delta > 0 and the performer is the payer
Extension point of EX07: Collect required funding
endlegend
@enduml
