      "css": ".ds-confirm{font-family:var(--shop-body,'Be Vietnam Pro',sans-serif);max-width:480px;padding:28px;border-radius:12px;background:var(--shop-paper,#fffcf5);color:var(--shop-ink,#281914);box-shadow:0 18px 60px #28191440}.ds-confirm-title{font-size:1.25rem;font-weight:700;line-height:1.5;margin:0 0 14px}.ds-confirm-copy{font-size:.9rem;color:var(--shop-muted,#716157);line-height:1.8;margin:0 0 20px}.ds-confirm-actions{display:flex;justify-content:flex-end;gap:12px;flex-wrap:wrap;margin-top:24px}.ds-cancel,.ds-confirm-button{font-family:var(--shop-body,'Be Vietnam Pro',sans-serif);min-height:46px;padding:10px 16px;border-radius:8px;font-size:.85rem;font-weight:700;line-height:1.6;cursor:pointer}.ds-cancel{background:transparent;border:1px solid var(--shop-line,#d9cbbd);color:var(--shop-wine,#5c0202)}.ds-confirm-button{background:var(--shop-wine,#5c0202);color:var(--shop-cream,#fcf8db);border:0}.ds-cancel:hover{background:#f0e2ca}.ds-confirm-button:hover{background:#7c2320}.ds-cancel:disabled,.ds-confirm-button:disabled{opacity:.6;cursor:default}.ds-confirm button:focus-visible{outline:3px solid var(--shop-wine,#5c0202);outline-offset:4px}"
